    --au-border-width-none: var(--au-dimensions-0);
    --au-border-width-thin: var(--au-dimensions-1);
    --au-border-width-medium: var(--au-dimensions-2);
    --au-border-width-thick: var(--au-dimensions-4);
    --au-sizes-height-header: var(--au-dimensions-72);
    --au-sizes-height-footer: var(--au-dimensions-52);
  }
}

