  --au-colors-border-error-solid: var(--au-colors-feedback-error-500);
  --au-colors-border-error-subtile: var(--au-colors-feedback-error-300);
  --au-glow: radial-gradient(circle, var(--au-colors-alpha-white-500) 0%, var(--au-colors-alpha-white-1000) 100%);
}

/* mobile.css */
@media (max-width: 480px) {
