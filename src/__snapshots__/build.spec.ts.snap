  --au-colors-alpha-white-900: #ffffff08;
  --au-colors-alpha-white-1000: #ffffff00;
  --au-colors-brand-primary-50: #f1f8f8;
  --au-colors-brand-primary-100: #e6f0ef;
  --au-colors-brand-primary-200: #b3cecd;
  --au-colors-brand-primary-300: #91b9b9;
  --au-colors-brand-primary-400: #6ea2a2;
