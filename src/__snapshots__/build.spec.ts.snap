exports[`build > should output the react native tokens file 1`] = `
"export const tokens = {
  "global": {
    "color": {
      "neutral": {
        "light": {
          "50": "#f5f7f7",
          "100": "#e6ebeb",
          "200": "#d9dedf",
          "300": "#b4b7bc",
          "400": "#9ca4a6",
          "500": "#859090",
          "600": "#6b7676",
          "700": "#525d5d",
          "800": "#3a4444",
          "900": "#242d2d",
          "white": "#ffffff"
        },
        "dark": {
          "50": "#e9ebef",
          "100": "#d2d6de",
          "200": "#bdc1cb",
          "300": "#9da3b0",
          "400": "#676d77",
          "500": "#353a42",
          "600": "#2a2f38",
          "700": "#1f242d",
          "800": "#181d27",
          "900": "#121621",
          "black": "#000000"
        }
      },
