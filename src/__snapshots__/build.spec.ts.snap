  --au-colors-feedback-warning-300: #fec84b; 
  --au-colors-feedback-warning-400: #fdb022; 
  --au-colors-feedback-warning-500: #f79009; 
  --au-colors-feedback-warning-600: #dc6803; 
  --au-colors-feedback-warning-700: #b54708; 
  --au-colors-feedback-warning-800: #93370d; 
  --au-colors-feedback-warning-900: #4e1d09; 
  --au-colors-feedback-success-50: #ecfdf3;
  --au-colors-feedback-success-100: #dcfae6; 
