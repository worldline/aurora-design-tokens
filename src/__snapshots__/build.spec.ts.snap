  --au-surface-brand-background: var(--au-color-neutral-dark-900);
  --au-surface-brand-solid: var(--au-color-brand-primary-500);
  --au-surface-brand-solid-hover: var(--au-color-brand-primary-700);
  --au-surface-brand-subtile: var(--au-color-brand-primary-900);
  --au-surface-info-solid: var(--au-color-feedback-info-400);
  --au-surface-info-subtile: var(--au-color-feedback-info-900);
  --au-surface-success-solid: var(--au-color-feedback-success-400);
  --au-surface-success-subtile: var(--au-color-feedback-success-900);
  --au-surface-warning-solid: var(--au-color-feedback-warning-400);
  --au-surface-warning-subtile: var(--au-color-feedback-warning-900);
  --au-surface-page: var(--au-color-neutral-dark-900);
  --au-surface-error-solid: var(--au-color-feedback-error-400);
  --au-surface-error-subtile: var(--au-color-feedback-error-900);
  --au-surface-invert: var(--au-color-neutral-light-white);
  --au-surface-disabled: var(--au-color-neutral-dark-800);
  --au-content-primary-static: var(--au-color-neutral-dark-900);
  --au-content-primary: var(--au-color-neutral-dark-50);
  --au-content-secondary: var(--au-color-neutral-dark-200);
  --au-content-tertiary: var(--au-color-neutral-dark-300);
  --au-content-placeholder: var(--au-color-neutral-dark-300);
  --au-content-invert: var(--au-color-neutral-dark-900);
  --au-content-disabled: var(--au-color-neutral-dark-400);
  --au-content-brand: var(--au-color-brand-primary-300);
  --au-content-on-brand: var(--au-color-neutral-light-white);
  --au-content-on-brand-hover: var(--au-color-alpha-white-200);
  --au-content-info: var(--au-color-feedback-info-400);
  --au-content-success: var(--au-color-feedback-success-400);
  --au-content-warning: var(--au-color-feedback-warning-400);
  --au-content-error: var(--au-color-feedback-error-400);
  --au-border-disabled: var(--au-color-neutral-dark-400);
  --au-border-neutral-low: var(--au-color-neutral-dark-600);
  --au-border-neutral-medium: var(--au-color-neutral-dark-400);
  --au-border-neutral-high: var(--au-color-neutral-dark-200);
  --au-border-brand-solid: var(--au-color-brand-primary-300);
  --au-border-brand-subtile: var(--au-color-brand-primary-700);
  --au-border-info-solid: var(--au-color-feedback-info-400);
  --au-border-info-subtile: var(--au-color-feedback-info-700);
  --au-border-success-solid: var(--au-color-feedback-success-400);
  --au-border-success-subtile: var(--au-color-feedback-success-700);
  --au-border-warning-solid: var(--au-color-feedback-warning-400);
  --au-border-warning-subtile: var(--au-color-feedback-warning-700);
  --au-border-error-solid: var(--au-color-feedback-error-400);
  --au-border-error-subtile: var(--au-color-feedback-error-700);
}

/* desktop-md.css */
@media screen and (min-width: 1281px) {
  :root {
    --au-screen-device: desktop-md;
    --au-screen-breakpoint: 1440px;
    --au-screen-content-max-width-xs: 360px;
