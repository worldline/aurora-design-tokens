/* dark.css */
.dark {
  --au-glow: radial-gradient(circle, var(--au-colors-alpha-white-500) 0%, var(--au-colors-alpha-white-1000) 100%);
  --au-surface-neutral-low: var(--au-colors-neutral-dark-800);
  --au-surface-neutral-low-hover: var(--au-colors-neutral-dark-700);
  --au-surface-neutral-medium: var(--au-colors-neutral-dark-700);
  --au-surface-neutral-medium-hover: var(--au-colors-neutral-dark-600);
  --au-surface-neutral-high: var(--au-colors-neutral-dark-600);
  --au-surface-neutral-high-hover: var(--au-colors-neutral-dark-500);
  --au-surface-brand-solid: var(--au-colors-brand-primary-500);
  --au-surface-brand-solid-hover: var(--au-colors-brand-primary-700);
  --au-surface-brand-subtile: var(--au-colors-neutral-dark-900);
  --au-surface-info-solid: var(--au-colors-feedback-info-400);
  --au-surface-info-subtile: var(--au-colors-feedback-info-900);
  --au-surface-success-solid: var(--au-colors-feedback-success-400);
  --au-surface-success-subtile: var(--au-colors-feedback-success-900);
  --au-surface-warning-solid: var(--au-colors-feedback-warning-400);
  --au-surface-warning-subtile: var(--au-colors-feedback-warning-900);
  --au-surface-page: var(--au-colors-neutral-dark-900);
  --au-surface-error-solid: var(--au-colors-feedback-error-400);
  --au-surface-error-subtile: var(--au-colors-feedback-error-900);
  --au-surface-invert: var(--au-colors-neutral-dark-900);
  --au-surface-disabled: var(--au-colors-neutral-dark-700);
  --au-content-primary-static: var(--au-colors-neutral-dark-900);
  --au-content-primary: var(--au-colors-neutral-dark-50);
  --au-content-secondary: var(--au-colors-neutral-dark-300);
  --au-content-tertiary: var(--au-colors-neutral-light-400);
  --au-content-placeholder: var(--au-colors-neutral-dark-400);
  --au-content-invert: var(--au-colors-neutral-dark-900);
  --au-content-disabled: var(--au-colors-neutral-dark-400);
  --au-content-brand: var(--au-colors-brand-primary-300);
  --au-content-on-brand: var(--au-colors-neutral-light-white);
  --au-content-on-brand-hover: var(--au-colors-alpha-white-200);
  --au-content-info: var(--au-colors-feedback-info-400);
  --au-content-success: var(--au-colors-feedback-success-400);
  --au-content-warning: var(--au-colors-feedback-warning-400);
  --au-content-error: var(--au-colors-feedback-error-400);
  --au-border-disabled: var(--au-colors-neutral-dark-600);
  --au-border-neutral-low: var(--au-colors-neutral-dark-600);
  --au-border-neutral-medium: var(--au-colors-neutral-dark-400);
  --au-border-neutral-high: var(--au-colors-neutral-dark-200);
  --au-border-brand-solid: var(--au-colors-brand-primary-500);
  --au-border-brand-subtile: var(--au-colors-brand-primary-400);
  --au-border-info-solid: var(--au-colors-feedback-info-400);
  --au-border-info-subtile: var(--au-colors-feedback-info-700);
  --au-border-success-solid: var(--au-colors-feedback-success-400);
  --au-border-success-subtile: var(--au-colors-feedback-success-700);
  --au-border-warning-solid: var(--au-colors-feedback-warning-400);
  --au-border-warning-subtile: var(--au-colors-feedback-warning-700);
  --au-border-error-solid: var(--au-colors-feedback-error-400);
  --au-border-error-subtile: var(--au-colors-feedback-error-700);
}

/* desktop-md.css */
@media screen and (min-width: 1281px) {
  :root {
    --au-screen-device: desktop-md;
    --au-screen-breakpoint: 1440px;
    --au-screen-content-max-width-xs: 360px;
