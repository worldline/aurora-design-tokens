  --au-colors-content-primary: var(--au-colors-neutral-dark-50);
  --au-colors-content-secondary: var(--au-colors-neutral-dark-300);
  --au-colors-content-tertiary: var(--au-colors-neutral-dark-300);
  --au-colors-content-placeholder: var(--au-colors-neutral-dark-400);
  --au-colors-content-invert: var(--au-colors-neutral-dark-900);
  --au-colors-content-disabled: var(--au-colors-neutral-dark-400);
  --au-colors-content-brand: var(--au-colors-brand-primary-300);
  --au-colors-content-on-brand: var(--au-colors-neutral-light-white);
  --au-colors-content-on-brand-hover: var(--au-colors-alpha-white-200);
  --au-colors-content-error: var(--au-colors-feedback-error-300);
  --au-colors-content-warning: var(--au-colors-feedback-warning-300);
  --au-colors-content-success: var(--au-colors-feedback-success-300);
  --au-colors-border-disabled: var(--au-colors-neutral-dark-600);
  --au-colors-border-neutral-low: var(--au-colors-neutral-dark-600);
  --au-colors-border-neutral-medium: var(--au-colors-neutral-dark-500);
  --au-colors-border-neutral-high: var(--au-colors-neutral-dark-400);
  --au-colors-border-brand-solid: var(--au-colors-brand-primary-500);
  --au-colors-border-brand-subtile: var(--au-colors-brand-primary-700);
  --au-colors-border-error-solid: var(--au-colors-feedback-error-500);
  --au-colors-border-error-subtile: var(--au-colors-feedback-error-700);
  --au-glow: radial-gradient(circle, var(--au-colors-alpha-white-500) 0%, var(--au-colors-alpha-white-1000) 100%);
}

/* desktop.css */
@media (min-width: 1025px) {
  :root {
    --au-typography-font-weight-light: 300rem;
    --au-typography-font-weight-regular: 400rem;
    --au-typography-font-weight-medium: 500rem;
    --au-typography-font-weight-semibold: 600rem;
    --au-typography-font-weight-bold: 700rem;
    --au-screen-breakpoint: 1024px;
    --au-typography-font-sizes-3xs: var(--au-dimensions-12);
