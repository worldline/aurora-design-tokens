/* dark.css */
.dark {
  --au-colors-surface-page: var(--au-colors-neutral-dark-900);
  --au-colors-surface-invert: var(--au-colors-neutral-dark-900);
  --au-colors-surface-disabled: var(--au-colors-neutral-dark-700);
