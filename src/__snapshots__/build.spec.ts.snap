/* dark.css */
.dark {
  --au-glow: radial-gradient(circle, var(--au-color-alpha-white-500) 0%, var(--au-color-alpha-white-1000) 100%);
  --au-surface-neutral-low: var(--au-color-neutral-dark-800);
  --au-surface-neutral-low-hover: var(--au-color-neutral-dark-700);
  --au-surface-neutral-medium: var(--au-color-neutral-dark-600);
  --au-surface-neutral-medium-hover: var(--au-color-neutral-dark-500);
  --au-surface-neutral-high: var(--au-color-neutral-dark-400);
