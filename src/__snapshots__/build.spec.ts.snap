  --au-chip-error-background: var(--au-surface-error-subtile);
  --au-chip-error-content: var(--au-content-error);
  --au-focus-ring: 0 0 0 var(--au-border-width-medium) var(--au-surface-page), 0 0 0 var(--au-border-width-thick) var(--au-surface-brand-solid);
}

/* light.css */
.light {
  --au-glow: radial-gradient(circle, var(--au-colors-alpha-white-500) 0%, var(--au-colors-alpha-white-1000) 100%);
  --au-surface-neutral-low: var(--au-colors-neutral-light-50);
  --au-surface-neutral-low-hover: var(--au-colors-neutral-light-100);
  --au-surface-neutral-medium: var(--au-colors-neutral-light-white);
  --au-surface-neutral-medium-hover: var(--au-colors-neutral-light-50);
  --au-surface-neutral-high: var(--au-colors-neutral-light-100);
  --au-surface-neutral-high-hover: var(--au-colors-neutral-light-200);
  --au-surface-brand-solid: var(--au-colors-brand-primary-500);
  --au-surface-brand-solid-hover: var(--au-colors-brand-primary-700);
  --au-surface-brand-subtile: var(--au-colors-brand-primary-100);
  --au-surface-info-solid: var(--au-colors-feedback-info-500);
  --au-surface-info-subtile: var(--au-colors-feedback-info-100);
  --au-surface-success-solid: var(--au-colors-feedback-success-500);
  --au-surface-success-subtile: var(--au-colors-feedback-success-100);
  --au-surface-warning-solid: var(--au-colors-feedback-warning-500);
  --au-surface-warning-subtile: var(--au-colors-feedback-warning-100);
  --au-surface-page: var(--au-colors-neutral-light-white);
  --au-surface-error-solid: var(--au-colors-feedback-error-500);
  --au-surface-error-subtile: var(--au-colors-feedback-error-100);
  --au-surface-invert: var(--au-colors-neutral-light-white);
  --au-surface-disabled: var(--au-colors-neutral-light-50);
  --au-content-primary-static: var(--au-colors-neutral-dark-900);
  --au-content-primary: var(--au-colors-neutral-dark-900);
  --au-content-secondary: var(--au-colors-neutral-light-700);
  --au-content-tertiary: var(--au-colors-neutral-light-600);
  --au-content-placeholder: var(--au-colors-neutral-light-600);
  --au-content-invert: var(--au-colors-neutral-light-white);
  --au-content-disabled: var(--au-colors-neutral-light-400);
  --au-content-brand: var(--au-colors-brand-primary-500);
  --au-content-on-brand: var(--au-colors-neutral-light-white);
  --au-content-on-brand-hover: var(--au-colors-alpha-white-200);
  --au-content-info: var(--au-colors-feedback-info-700);
  --au-content-success: var(--au-colors-feedback-success-700);
  --au-content-warning: var(--au-colors-feedback-warning-700);
  --au-content-error: var(--au-colors-feedback-error-700);
  --au-border-disabled: var(--au-colors-neutral-light-300);
  --au-border-neutral-low: var(--au-colors-neutral-light-100);
  --au-border-neutral-medium: var(--au-colors-neutral-light-300);
  --au-border-neutral-high: var(--au-colors-neutral-light-500);
  --au-border-brand-solid: var(--au-colors-brand-primary-500);
  --au-border-brand-subtile: var(--au-colors-brand-primary-800);
  --au-border-info-solid: var(--au-colors-feedback-info-700);
  --au-border-info-subtile: var(--au-colors-feedback-info-300);
  --au-border-success-solid: var(--au-colors-feedback-success-700);
  --au-border-success-subtile: var(--au-colors-feedback-success-300);
  --au-border-warning-solid: var(--au-colors-feedback-warning-700);
  --au-border-warning-subtile: var(--au-colors-feedback-warning-300);
  --au-border-error-solid: var(--au-colors-feedback-error-700);
  --au-border-error-subtile: var(--au-colors-feedback-error-300);
}

/* mobile-sm.css */
@media screen and (min-width: 361px) and (max-width: 480px) {
  :root {
    --au-screen-device: mobile-sm;
    --au-screen-breakpoint: 393px;
    --au-screen-content-max-width-xs: 360px;
    --au-screen-content-max-width-sm: 408px;
    --au-screen-content-max-width-md: 640px;
    --au-screen-content-max-width-lg: 800px;
    --au-screen-content-max-width-xl: 1024px;
    --au-typescale-hero-font-size: var(--au-font-size-6xl);
    --au-typescale-hero-line-height: var(--au-line-height-3xl);
    --au-typescale-hero-letter-spacing: var(--au-letter-spacing-none);
