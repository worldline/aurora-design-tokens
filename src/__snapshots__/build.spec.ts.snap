  --au-chip-neutral-content: var(--au-colors-content-secondary);
  --au-chip-brand-background: var(--au-colors-surface-brand-subtile);
  --au-chip-brand-content: var(--au-colors-content-brand);
  --au-chip-success-background: var(--au-colors-surface-success-subtile);
  --au-chip-success-content: var(--au-colors-content-success);
  --au-chip-warning-background: var(--au-colors-surface-warning-subtile);
  --au-chip-warning-content: var(--au-colors-content-warning);
  --au-chip-error-background: var(--au-colors-surface-error-subtile);
  --au-chip-error-content: var(--au-colors-content-error);
  --au-header-background: var(--au-colors-surface-page);
  --au-header-content: var(--au-colors-content-primary);
  --au-header-padding-horizontal: var(--au-spacing-lg);
  --au-header-height: var(--au-sizes-height-header);
  --au-focus-ring: 0 0 0 var(--au-border-width-thick) #53bda4, 0 0 0 2px var(--au-colors-surface-invert);
}

/* light.css */
:root {
  --au-colors-surface-page: var(--au-colors-neutral-light-white);
  --au-colors-surface-invert: var(--au-colors-neutral-light-white);
  --au-colors-surface-disabled: var(--au-colors-neutral-light-50);
