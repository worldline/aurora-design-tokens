    --au-spacing-none: var(--au-dimensions-0);
    --au-spacing-3xs: var(--au-dimensions-2);
    --au-spacing-2xs: var(--au-dimensions-4);
    --au-spacing-xs: var(--au-dimensions-6);
    --au-spacing-sm: var(--au-dimensions-8);
    --au-spacing-md: var(--au-dimensions-10);
    --au-spacing-lg: var(--au-dimensions-12);
    --au-spacing-xl: var(--au-dimensions-14);
