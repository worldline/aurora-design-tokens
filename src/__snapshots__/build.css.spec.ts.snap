  --au-surface-warning-solid: var(--au-color-feedback-warning-500);
  --au-surface-warning-subtile: var(--au-color-feedback-warning-100);
  --au-surface-page: var(--au-color-neutral-light-50);
  --au-surface-danger-solid: var(--au-color-feedback-danger-500);
  --au-surface-danger-solid-hover: var(--au-color-feedback-danger-700);
  --au-surface-danger-subtile: var(--au-color-feedback-danger-100);
  --au-surface-danger-gradient-start: var(--au-color-feedback-danger-400);
  --au-surface-danger-gradient-end: var(--au-color-feedback-danger-500);
  --au-surface-invert: var(--au-color-neutral-dark-900);
