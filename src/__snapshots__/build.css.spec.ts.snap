  --au-surface-invert-alpha-high: var(--au-color-alpha-black-800);
  --au-surface-disabled: var(--au-color-neutral-light-50);
  --au-surface-scrim: var(--au-color-alpha-black-600);
  --au-surface-shadow: var(--au-color-alpha-black-700);
  --au-surface-glass: var(--au-color-alpha-white-200);
  --au-content-primary-static: var(--au-color-neutral-dark-900);
  --au-content-primary: var(--au-color-neutral-dark-900);
  --au-content-secondary: var(--au-color-neutral-light-700);
  --au-content-tertiary: var(--au-color-neutral-light-600);
  --au-content-placeholder: var(--au-color-neutral-light-600);
  --au-content-invert-static: var(--au-color-neutral-light-white);
  --au-content-invert: var(--au-color-neutral-light-white);
  --au-content-disabled: var(--au-color-neutral-light-400);
  --au-content-brand: var(--au-color-brand-primary-500);
  --au-content-on-brand: var(--au-color-neutral-light-white);
  --au-content-on-brand-hover: var(--au-color-alpha-white-200);
  --au-content-info: var(--au-color-feedback-info-700);
  --au-content-success: var(--au-color-feedback-success-700);
  --au-content-warning: var(--au-color-feedback-warning-700);
  --au-content-danger: var(--au-color-feedback-danger-700);
  --au-border-disabled: var(--au-color-neutral-light-400);
  --au-border-divider-light: var(--au-color-neutral-light-white);
  --au-border-divider-dark: var(--au-color-neutral-light-100);
  --au-border-neutral-low: var(--au-color-neutral-light-100);
  --au-border-neutral-medium: var(--au-color-neutral-light-300);
  --au-border-neutral-high: var(--au-color-neutral-light-500);
  --au-border-neutral-gradient-start: var(--au-color-neutral-light-100);
  --au-border-neutral-gradient-end: var(--au-color-neutral-light-300);
  --au-border-brand-solid: var(--au-color-brand-primary-500);
  --au-border-brand-subtile: var(--au-color-brand-primary-300);
  --au-border-brand-gradient-start: var(--au-color-brand-primary-300);
  --au-border-brand-gradient-end: var(--au-color-brand-primary-900);
  --au-border-info-solid: var(--au-color-feedback-info-700);
  --au-border-info-subtile: var(--au-color-feedback-info-300);
  --au-border-success-solid: var(--au-color-feedback-success-700);
  --au-border-success-subtile: var(--au-color-feedback-success-300);
  --au-border-warning-solid: var(--au-color-feedback-warning-700);
  --au-border-warning-subtile: var(--au-color-feedback-warning-300);
  --au-border-danger-solid: var(--au-color-feedback-danger-700);
  --au-border-danger-subtile: var(--au-color-feedback-danger-300);
  --au-border-danger-gradient-start: var(--au-color-feedback-danger-100);
  --au-border-danger-gradient-end: var(--au-color-feedback-danger-300);
  --au-glow-white: radial-gradient(circle, var(--au-color-alpha-white-500) 0%, var(--au-color-alpha-white-1000) 100%);
  --au-glow-brand: radial-gradient(circle, var(--au-surface-brand-solid) 0%, var(--au-surface-neutral-low-gradient-end) 100%);
  --au-glow-success: radial-gradient(circle, var(--au-surface-success-solid) 0%, var(--au-surface-neutral-low-gradient-end) 100%);
  --au-glow-warning: radial-gradient(circle, var(--au-surface-warning-solid) 0%, var(--au-surface-neutral-low-gradient-end) 100%);
  --au-glow-danger: radial-gradient(circle, var(--au-surface-danger-solid) 0%, var(--au-surface-neutral-low-gradient-end) 100%);
  --au-gradient-surface-brand: linear-gradient(125deg, var(--au-surface-brand-gradient-start) 0%, var(--au-surface-brand-gradient-end) 100%);
  --au-gradient-surface-neutral-low: linear-gradient(125deg, var(--au-surface-neutral-low-gradient-start) 0%, var(--au-surface-neutral-low-gradient-end) 100%);
  --au-gradient-surface-neutral-high: linear-gradient(125deg, var(--au-surface-neutral-high-gradient-start) 0%, var(--au-surface-neutral-high-gradient-end) 100%);
  --au-gradient-surface-destructive: linear-gradient(125deg, var(--au-surface-danger-gradient-start) 0%, var(--au-surface-danger-gradient-end) 100%);
  --au-gradient-surface-overlay: linear-gradient(180deg, var(--au-surface-neutral-low-gradient-start) 0%, var(--au-surface-neutral-low-gradient-end) 100%);
  --au-gradient-border-brand: linear-gradient(134deg, var(--au-border-brand-gradient-start) 0%, var(--au-border-brand-gradient-end) 100%);
  --au-gradient-border-neutral: linear-gradient(134deg, var(--au-border-neutral-gradient-start) 0%, var(--au-border-neutral-gradient-end) 100%);
  --au-gradient-border-destructive: linear-gradient(134deg, var(--au-border-danger-gradient-start) 0%, var(--au-border-danger-gradient-end) 100%);
}

