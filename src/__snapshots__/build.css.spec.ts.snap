  --au-surface-neutral-low-gradient-start: var(--au-color-neutral-light-white);
  --au-surface-neutral-low-gradient-end: var(--au-color-neutral-light-50);
  --au-surface-neutral-high-gradient-start: var(--au-color-neutral-dark-400);
  --au-surface-neutral-high-gradient-end: var(--au-color-neutral-dark-black);
