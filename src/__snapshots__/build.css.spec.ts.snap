/* light.css */
.light {
  --au-surface-neutral-low: var(--au-color-neutral-light-white);
  --au-surface-neutral-low-hover: var(--au-color-neutral-light-50);
  --au-surface-neutral-medium: var(--au-color-neutral-light-100);
