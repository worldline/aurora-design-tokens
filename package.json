{
  "name": "@worldline/aurora-design-tokens",
  "version": "1.0.4",
  "description": "create style sheets from design tokens files",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./style.css": "./build/css/style.css",
    "./colors.ts": "./build/css/colors.ts",
    "./typographies.ts": "./build/css/typographies.ts",
    "./variables.js": "./build/variables.js"
  },
  "files": [
    "build/css/style.css",
    "build/css/colors.ts",
    "build/css/typographies.ts",
    "build/variables.js"
  ],
  "scripts": {
    "build": "node src/build.ts",
    "build:watch": "node --watch --watch-path src --watch-path tokens src/build.ts",
    "lint": "eslint src",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "pack": "npm run build && npm pack",
    "ci:publish": "npm run build && npm publish --ignore-scripts",
    "semantic-release": "semantic-release",
    "ncui": "npx npm-check-updates -i",
    "prepare": "husky",
    "precommit:tasks": "lint-staged"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@semantic-release/commit-analyzer": "11.1.0",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "9.2.6",
    "@semantic-release/npm": "13.1.2",
    "@semantic-release/release-notes-generator": "12.1.0",
    "@types/node": "25.0.3",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.4",
    "prettier": "3.7.4",
    "semantic-release": "25.0.2",
    "style-dictionary": "5.1.1",
    "typescript-eslint": "8.52.0",
    "vitest": "4.0.16",
    "husky": "9.1.7",
    "lint-staged": "16.2.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
