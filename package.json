{
  "name": "@worldline/aurora-design-tokens",
  "version": "1.9.1",
  "description": "create style sheets from design tokens files",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./style.css": "./build/css/style.css",
    "./variables": {
      "import": "./build/variables.js",
      "types": "./build/variables.d.ts"
    },
    "./colors": {
      "import": "./build/types/colors.js",
      "types": "./build/types/colors.d.ts"
    },
    "./typographies": {
      "import": "./build/types/typographies.js",
      "types": "./build/types/typographies.d.ts"
    }
  },
  "files": [
    "build/css/style.css",
    "build/types/colors.d.ts",
    "build/types/colors.js",
    "build/types/typographies.d.ts",
    "build/types/typographies.js",
    "build/variables.js",
    "build/variables.d.ts"
  ],
  "scripts": {
    "build": "node src/build.ts",
    "build:watch": "node --watch --watch-path src --watch-path tokens src/build.ts",
    "postbuild": "tsc build/types/colors build/types/typographies --declaration --outDir build/types --declarationDir build/types",
    "lint": "eslint src",
    "lint:staged": "eslint --fix",
    "format:staged": "prettier --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "pack": "npm run build && npm pack",
    "ci:publish": "npm run build && npm publish --ignore-scripts",
    "semantic-release": "semantic-release",
    "ncui": "npx npm-check-updates -i"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/gitlab": "13.3.2",
    "@semantic-release/npm": "13.1.5",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@types/node": "25.5.0",
    "@vitest/coverage-v8": "4.1.2",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.5",
    "lefthook": "2.1.4",
    "prettier": "3.8.1",
    "semantic-release": "25.0.3",
    "style-dictionary": "5.4.0",
    "typescript-eslint": "8.57.2",
    "vitest": "4.1.2",
    "vitest-sonar-reporter": "3.0.0"
  }
}
