{
  "focus-ring": {
    "$type": "shadow",
    "$value": [
      {
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "{border-width.thick}",
        "color": "{surface.brand.solid}"
      },
      {
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "{border-width.medium}",
        "color": "{surface.page}"
      }
    ]
  },
  "button-primary-shadow": {
    "$type": "shadow",
    "$value": [
      {
        "offsetX": "0px",
        "offsetY": "-2px",
        "blur": "0px",
        "spread": "0px",
        "color": "{surface.shadow}",
        "inset": true
      }
    ]
  },
  "overlay-background": {
    "$type": "shadow",
    "$value": [
      {
        "offsetX": "0px",
        "offsetY": "14px",
        "blur": "28px",
        "spread": "0px",
        "color": "{surface.shadow}"
      },
      {
        "backgroundBlur": true,
        "blur": "{dimension.16}"
      }
    ]
  },
  "elevation": {
    "interactive": {
      "default": {
        "$type": "shadow",
        "$value": [
          {
            "offsetX": "0px",
            "offsetY": "1px",
            "blur": "3px",
            "spread": "0px",
            "color": "{surface.shadow}"
          }
        ]
      },
      "hover": {
        "$type": "shadow",
        "$value": [
          {
            "offsetX": "0px",
            "offsetY": "3px",
            "blur": "6px",
            "spread": "0px",
            "color": "{surface.shadow}"
          }
        ]
      },
      "overlay": {
        "$type": "shadow",
        "$value": [
          {
            "offsetX": "0px",
            "offsetY": "10px",
            "blur": "20px",
            "spread": "0px",
            "color": "{surface.shadow}"
          }
        ]
      }
    },
    "content": {
      "overlay": {
        "$type": "shadow",
        "$value": [
          {
            "offsetX": "0px",
            "offsetY": "14px",
            "blur": "28px",
            "spread": "0px",
            "color": "{surface.shadow}"
          }
        ]
      },
      "style": {
        "$type": "shadow",
        "$value": [
          {
            "offsetX": "0px",
            "offsetY": "0px",
            "blur": "38px",
            "spread": "0px",
            "color": "{surface.shadow}"
          }
        ]
      }
    }
  },
  "blur": {
    "scrim": {
      "$type": "shadow",
      "$value": [
        {
          "backgroundBlur": true,
          "blur": "{dimension.24}"
        }
      ]
    },
    "glass": {
      "$type": "shadow",
      "$value": [
        {
          "backgroundBlur": true,
          "blur": "{dimension.8}"
        }
      ]
    }
  }
}
